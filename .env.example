# DEVELOPMENT DEMO ONLY. Copy to .env, then replace every value marked CHANGE_ME.
POSTGRES_DB=stockstack
POSTGRES_USER=stockstack
POSTGRES_PASSWORD=CHANGE_ME_local_database_password
JWT_SECRET=CHANGE_ME_generate_at_least_32_random_bytes
ADMIN_USERNAME=admin
# Demo login password for this example hash: stockstack-demo. Never use in production.
# Generate a replacement: cd backend && uv run python -c 'from pwdlib import PasswordHash; print(PasswordHash.recommended().hash("your-password"))'
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$2tDqr91Taodsdisvw4dk6g$SY6i0L/1jpLrjCL1m7E7rilb6ayiI6ygWePhdNExF4I'
ACCESS_TOKEN_EXPIRE_MINUTES=60
WEB_PORT=8080
CACHE_TTL_SECONDS=300
CACHE_TTL_JITTER_SECONDS=30
NEGATIVE_CACHE_TTL_SECONDS=30
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
DB_FALLBACK_CONCURRENCY_LIMIT=10
